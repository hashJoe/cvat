version: '3.3'
services:
  cvat_server:
    entrypoint: ["/bin/sh", "-c", "rm -rf /home/django/share && ln -s /home/django/external_share /home/django/share && exec ./backend_entrypoint.sh init run server"]
    environment:
      CVAT_SHARE_URL: "Mounted from /home/lemon/anomaly/images_for_cvat"
    volumes:
      - type: bind
        source: /home/lemon/anomaly/images_for_cvat
        target: /home/django/external_share
        read_only: true
